{
  "name": "weather-charqueadas",
  "version": "1.0.0",
  "description": "Meteorological risk and weather forecast monitor for Charqueadas - RS using Node.js 26 and Docker Compose",
  "type": "module",
  "main": "src/weather_bot.js",
  "scripts": {
    "start": "node src/weather_bot.js",
    "migrate": "node src/helpers/migrate.js",
    "monitor:console": "node src/monitoring/monitor_service.js",
    "monitor:regional": "node scripts/monitor_regional_risks.js",
    "db:logs": "node src/model/log_database.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "weather",
    "inmet",
    "charqueadas",
    "node26",
    "docker-compose"
  ],
  "author": "Pablo Werlang",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "html-to-text": "^9.0.5",
    "mjml": "^4.15.3",
    "nodemailer": "^7.0.6"
  }
}
